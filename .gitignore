# Python bytecode and packaging artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local config — config.json contains live Vault credentials.
# Use config.json.example as a template; copy it to config.json locally.
config.json

# Runtime logs (rotating files generated by the server)
Log/
*.log

# IDE / editor state
.vscode/
.idea/
*.swp
*~

# Claude Code local state (per-project, not for sharing)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Standalone PyInstaller build outputs — build the .exe locally, don't commit it
*.exe
*.spec
build_purchasing_log.txt

# Playwright MCP scratch output
.playwright-mcp/

# Git worktrees for isolated feature work — these are checkouts of this same
# repo, so they must never be tracked by it.
.worktrees/

# Local machine-provisioning scripts — unrelated to Vault-MCP, kept here only
# for convenience. Never commit these.
/Setup-NewPC*

# Sample handoff PDFs generated while eyeballing the renderer's layout. The
# real ones are written into the Vault workspace, never here.
/sample-handoff.pdf

# OS junk
.DS_Store
Thumbs.db
inventor-addin/**/bin/
inventor-addin/**/obj/
inventor-addin/tools/
build/sfvaulttools/
